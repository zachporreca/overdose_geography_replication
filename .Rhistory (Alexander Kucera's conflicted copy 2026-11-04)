##----------------------------------------------------------
## 11. Shiny server
##----------------------------------------------------------
server <- function(input, output, session) {
##--------------------------------------------------------
## Selected rolling window
##--------------------------------------------------------
selected_window <- reactive({
req(input$window_start)
get_window_data(
data = rolling_correlations,
window_start = input$window_start
)
})
selected_window_label <- reactive({
window_data <- selected_window()
if (nrow(window_data) == 0) {
return("")
}
unique(window_data$Window_label)[1]
})
output$selected_window_text <- renderText({
paste0(
"Selected window: ",
selected_window_label()
)
})
##--------------------------------------------------------
## Update maximum number of connections
##--------------------------------------------------------
observe({
window_data <- selected_window()
req(nrow(window_data) > 0)
new_maximum <- nrow(window_data)
new_value <- min(
isolate(input$top_n),
new_maximum
)
updateSliderInput(
session = session,
inputId = "top_n",
max = new_maximum,
value = new_value
)
})
##--------------------------------------------------------
## National top connections
##--------------------------------------------------------
national_edges <- reactive({
window_data <- selected_window()
get_top_connections(
data = window_data,
top_n = input$top_n
)
})
##--------------------------------------------------------
## State data
##
## State filtering occurs before selecting top X.
## Thus, it shows the top X connections involving that
## state, rather than state connections surviving a
## national top-X filter.
##--------------------------------------------------------
state_edges <- reactive({
req(input$state)
req(input$state != "National")
state_data <- selected_window() %>%
filter(
State1 == input$state |
State2 == input$state
)
get_top_connections(
data = state_data,
top_n = input$top_n
)
})
##--------------------------------------------------------
## Update focus-city choices
##--------------------------------------------------------
observe({
window_data <- selected_window()
if (isTRUE(input$limit_city_choices)) {
city_source <- national_edges()
} else {
city_source <- window_data
}
cities <- sort(
unique(
c(
city_source$City1,
city_source$City2
)
)
)
cities <- cities[
!is.na(cities) &
cities != ""
]
previous_city <- isolate(input$focus_city)
selected_city <- if (
!is.null(previous_city) &&
previous_city %in% cities
) {
previous_city
} else if (length(cities) > 0) {
cities[1]
} else {
character(0)
}
updateSelectInput(
session = session,
inputId = "focus_city",
choices = cities,
selected = selected_city
)
})
##--------------------------------------------------------
## City-specific connections
##
## Filtering for the focus city occurs first, followed by
## selecting that city's top X connections.
##--------------------------------------------------------
city_edges <- reactive({
req(input$focus_city)
city_data <- selected_window() %>%
filter(
City1 == input$focus_city |
City2 == input$focus_city
)
get_top_connections(
data = city_data,
top_n = input$top_n
)
})
##--------------------------------------------------------
## National plot
##--------------------------------------------------------
output$national_plot <- renderPlot({
edges <- national_edges()
validate(
need(
nrow(edges) > 0,
"No connections are available for this window."
)
)
plot_network_map(
edge_data = edges,
title_text = paste0(
"Top ",
nrow(edges),
" national connections"
),
subtitle_text = paste0(
"Rolling window: ",
selected_window_label()
)
)
})
##--------------------------------------------------------
## State plot
##--------------------------------------------------------
output$state_plot <- renderPlot({
validate(
need(
input$state != "National",
"Select a state from the sidebar."
)
)
edges <- state_edges()
validate(
need(
nrow(edges) > 0,
paste0(
"No connections are available for ",
input$state,
" in this window."
)
)
)
plot_network_map(
edge_data = edges,
title_text = paste0(
"Top ",
nrow(edges),
" connections involving ",
input$state
),
subtitle_text = paste0(
"Rolling window: ",
selected_window_label()
)
)
})
##--------------------------------------------------------
## City-specific plot
##--------------------------------------------------------
output$city_plot <- renderPlot({
req(input$focus_city)
edges <- city_edges()
validate(
need(
nrow(edges) > 0,
paste0(
"No connections are available for ",
input$focus_city,
" in this window."
)
)
)
plot_network_map(
edge_data = edges,
title_text = paste0(
"Top ",
nrow(edges),
" connections for ",
input$focus_city
),
subtitle_text = paste0(
"Rolling window: ",
selected_window_label()
),
focus_city = input$focus_city
)
})
##--------------------------------------------------------
## Data table
##--------------------------------------------------------
output$connection_table <- renderTable({
national_edges() %>%
transmute(
Window = Window_label,
City1,
City2,
`Average price: City 1` = round(
Avg_Pure_price1,
2
),
`Average price: City 2` = round(
Avg_Pure_price2,
2
),
`Common years` = N_paired_years,
Correlation = round(
Correlation,
3
)
)
})
}
