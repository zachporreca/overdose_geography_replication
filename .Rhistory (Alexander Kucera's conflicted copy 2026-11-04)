long = long2,
Avg_Pure_price = Avg_Pure_price2
)
degree_data <- edge_data %>%
select(
City1,
City2
) %>%
pivot_longer(
cols = c(City1, City2),
names_to = "city_position",
values_to = "City"
) %>%
count(
City,
name = "Degree"
)
bind_rows(
city1_nodes,
city2_nodes
) %>%
group_by(
City,
State
) %>%
summarise(
lat = first(lat),
long = first(long),
Avg_Pure_price = first(Avg_Pure_price),
.groups = "drop"
) %>%
left_join(
degree_data,
by = "City"
)
}
##----------------------------------------------------------
## 9. General network map
##----------------------------------------------------------
plot_network_map <- function(
edge_data,
title_text,
subtitle_text = NULL,
focus_city = NULL
) {
if (is.null(edge_data) || nrow(edge_data) == 0) {
return(NULL)
}
node_data <- build_node_data(edge_data)
node_data <- node_data %>%
mutate(
Focus_city = if (
is.null(focus_city) ||
length(focus_city) == 0 ||
is.na(focus_city) ||
focus_city == ""
) {
FALSE
} else {
City == focus_city
}
)
ggplot() +
geom_polygon(
data = world_sub,
aes(
x = long,
y = lat,
group = group
),
fill = "grey95",
color = "grey70",
linewidth = 0.3
) +
geom_polygon(
data = us_map,
aes(
x = long,
y = lat,
group = group
),
fill = NA,
color = "grey65",
linewidth = 0.35
) +
geom_curve(
data = edge_data,
aes(
x = long1,
y = lat1,
xend = long2,
yend = lat2,
linewidth = abs(Correlation),
alpha = abs(Correlation),
color = Correlation
),
curvature = 0.08
) +
geom_point(
data = node_data,
aes(
x = long,
y = lat,
size = Avg_Pure_price,
fill = Focus_city
),
shape = 21,
color = "black",
stroke = 0.3,
alpha = 0.9
) +
coord_fixed(
ratio = 1.3,
xlim = c(-125, -66),
ylim = c(24, 50)
) +
scale_color_gradient2(
low = "#B2182B",
mid = "grey80",
high = "#2166AC",
midpoint = 0,
limits = c(-1, 1),
name = "Correlation"
) +
scale_linewidth(
range = c(0.25, 1.25),
guide = "none"
) +
scale_alpha(
range = c(0.35, 0.9),
guide = "none"
) +
scale_size_continuous(
range = c(2, 7),
name = "Average price"
) +
scale_fill_manual(
values = c(
"FALSE" = "white",
"TRUE" = "#FFD700"
),
guide = "none"
) +
labs(
title = title_text,
subtitle = subtitle_text,
x = NULL,
y = NULL
) +
base_theme
}
