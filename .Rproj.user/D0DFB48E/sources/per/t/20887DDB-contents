##----------------------------------------------------------
## 0. File paths
##----------------------------------------------------------

data_dir <- "/Users/alexkucera/Dropbox/Stride_Detailed_Analysis/data"

correlation_file <- file.path(
  data_dir,
  "rolling_15_year_correlations",
  "all_rolling_correlations.rds"
)

city_geo_file <- file.path(
  "/Users/alexkucera/Dropbox/Stride_Detailed_Analysis",
  "margret_initial_analysis",
  "locations_with_coords.csv"
)

##----------------------------------------------------------
## 1. Load rolling correlations
##----------------------------------------------------------

rolling_correlations <- readRDS(correlation_file) %>%
  mutate(
    Window_start = as.integer(Window_start),
    Window_end = as.integer(Window_end),
    Window_label = as.character(Window_label),
    
    City1 = City1 %>%
      str_squish() %>%
      str_replace("\\s*,?\\s+([A-Za-z]{2})$", ", \\1"),
    
    City2 = City2 %>%
      str_squish() %>%
      str_replace("\\s*,?\\s+([A-Za-z]{2})$", ", \\1"),
    
    State1 = str_extract(City1, "[A-Za-z]{2}$") %>%
      str_to_upper(),
    
    State2 = str_extract(City2, "[A-Za-z]{2}$") %>%
      str_to_upper()
  ) %>%
  filter(
    N_paired_years >= 10,
    !is.na(Correlation),
    is.finite(Correlation)
  )

##----------------------------------------------------------
## 2. Load and clean city coordinates
##----------------------------------------------------------

city_geo <- read.csv(
  city_geo_file,
  stringsAsFactors = FALSE
) %>%
  transmute(
    City = mylocations %>%
      str_squish() %>%
      str_replace("\\s*,?\\s+([A-Za-z]{2})$", ", \\1"),
    
    lat = as.numeric(latitude),
    long = as.numeric(longitude)
  ) %>%
  filter(
    !is.na(City),
    !is.na(lat),
    !is.na(long)
  ) %>%
  distinct(
    City,
    .keep_all = TRUE
  )

##----------------------------------------------------------
## 3. Add coordinates to both cities
##----------------------------------------------------------

rolling_correlations <- rolling_correlations %>%
  left_join(
    city_geo %>%
      rename(
        City1 = City,
        lat1 = lat,
        long1 = long
      ),
    by = "City1",
    relationship = "many-to-one"
  ) %>%
  left_join(
    city_geo %>%
      rename(
        City2 = City,
        lat2 = lat,
        long2 = long
      ),
    by = "City2",
    relationship = "many-to-one"
  )

# Report city names that do not have coordinates.
missing_city_coordinates <- rolling_correlations %>%
  select(
    City1,
    City2,
    lat1,
    long1,
    lat2,
    long2
  ) %>%
  pivot_longer(
    cols = everything(),
    names_to = c(".value", "city_number"),
    names_pattern = "(City|lat|long)([12])"
  ) %>%
  filter(
    is.na(lat) | is.na(long)
  ) %>%
  distinct(City)

if (nrow(missing_city_coordinates) > 0) {
  message("Cities missing coordinates:")
  print(missing_city_coordinates)
}

# Connections cannot be mapped unless both cities have coordinates.
rolling_correlations <- rolling_correlations %>%
  filter(
    !is.na(lat1),
    !is.na(long1),
    !is.na(lat2),
    !is.na(long2)
  )

if (nrow(rolling_correlations) == 0) {
  stop(
    "No mappable correlation pairs remain after joining city coordinates."
  )
}

