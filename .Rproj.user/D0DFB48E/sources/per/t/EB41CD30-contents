# function to create assignments
make_role_table <- function(df, title) {
  table_data <- df %>%
    arrange(hub_rank_pre) %>%
    transmute(
      City,
      degree_pre = indegree_pre + outdegree_pre,
      degree_post = indegree_post + outdegree_post,
      mean_corr_pre = mean_corr_all_pre,
      mean_corr_post = mean_corr_all_post
    ) %>%
    arrange(desc(degree_pre), City)  %>%
    mutate(across(starts_with("mean_corr"), ~ round(.x, 3)))
  
  filename <- gsub(" ", "_", tolower(title))
  write.csv(table_data, paste0(filename, ".csv"), row.names = FALSE)
  
  tab <- table_data %>%
    kbl(
      format = "latex",
      booktabs = TRUE,
      digits = c(0, 0, 0, 3, 3),
      col.names = c(
        "City", "Degree ()", "Degree (post)",
        "Mean corr. (pre)", "Mean corr. (post)"
      ),
      caption = title,
      align = c("l", rep("r", 4)),
      escape = TRUE
    ) %>%
    kable_styling(
      latex_options = "hold_position",
      full_width = FALSE,
      position = "center"
    ) %>%
    footnote(
      general = paste0(
        "Degree counts undirected connections with correlation above ",
        corr_threshold,
        ". Mean correlation is the average over retained connections. ",
        "Core status is estimated separately by period using the weighted ",
        "core-periphery model. The sample includes cities observed in all ",
        "three periods."
      ),
      general_title = "Notes: ",
      threeparttable = TRUE
    )
  
  
  writeLines(as.character(tab), paste0(filename, ".tex"))
  tab
}



