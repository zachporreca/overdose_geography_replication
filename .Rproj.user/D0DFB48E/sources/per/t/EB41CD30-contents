# ============================================================
# Weighted Borgatti-Everett core-periphery model
# ============================================================

# This function maximizes the correlation between:
#
#   observed weighted adjacency matrix
#
# and the ideal core-periphery matrix:
#
#   core-core       = 1
#   core-periphery  = 0
#   periphery-core  = 0
#   periphery-periphery = 0
#
# The algorithm uses multiple random starts and greedy node flipping.
#
# Important:
# A correlation threshold is still used to define which edges enter
# the network. The Borgatti-Everett model then uses the retained
# correlations as weights.

fit_weighted_be_core <- function(A,
                                 n_restarts = 100,
                                 max_iter = 1000,
                                 min_core_size = 1,
                                 max_core_size = nrow(A) - 1,
                                 seed = 123) {
  
  set.seed(seed)
  
  A <- as.matrix(A)
  A[is.na(A)] <- 0
  diag(A) <- 0
  
  n <- nrow(A)
  
  if (n < 3) {
    stop("At least three nodes are required.")
  }
  
  # Symmetrize the matrix. This is appropriate because correlations
  # are symmetric. If your data contain genuinely directed edges,
  # this model should not be applied to the directed graph.
  A <- (A + t(A)) / 2
  diag(A) <- 0
  
  # Scale weights between 0 and 1.
  max_A <- max(A, na.rm = TRUE)
  
  if (!is.finite(max_A) || max_A <= 0) {
    stop("The adjacency matrix contains no positive edge weights.")
  }
  
  W <- A / max_A
  
  # Use only the upper triangle so that each undirected edge is counted once.
  upper_index <- upper.tri(W)
  observed <- W[upper_index]
  
  # Objective:
  # Pearson correlation between observed edge weights and the ideal
  # core-periphery structure.
  objective <- function(core_membership) {
    
    ideal <- outer(
      core_membership,
      core_membership,
      FUN = "*"
    )
    
    ideal_values <- ideal[upper_index]
    
    # Correlation is undefined if all ideal values are identical.
    if (sd(ideal_values) == 0 || sd(observed) == 0) {
      return(-Inf)
    }
    
    cor(observed, ideal_values, use = "complete.obs")
  }
  
  # Enforce a minimum and maximum number of core nodes.
  valid_membership <- function(x) {
    sum(x) >= min_core_size &&
      sum(x) <= max_core_size
  }
  
  best_score <- -Inf
  best_membership <- NULL
  
  for (restart in seq_len(n_restarts)) {
    
    # Random initial allocation, subject to minimum/maximum core size
    initial_core_size <- sample(
      min_core_size:max_core_size,
      size = 1
    )
    
    membership <- rep(0L, n)
    membership[
      sample(seq_len(n), initial_core_size)
    ] <- 1L
    
    current_score <- objective(membership)
    improved <- TRUE
    iteration <- 0
    
    while (improved && iteration < max_iter) {
      
      improved <- FALSE
      iteration <- iteration + 1
      
      # Randomly inspect nodes to avoid a deterministic search order
      node_order <- sample(seq_len(n))
      
      for (i in node_order) {
        
        proposal <- membership
        proposal[i] <- 1L - proposal[i]
        
        if (!valid_membership(proposal)) {
          next
        }
        
        proposal_score <- objective(proposal)
        
        if (is.finite(proposal_score) &&
            proposal_score > current_score) {
          
          membership <- proposal
          current_score <- proposal_score
          improved <- TRUE
        }
      }
    }
    
    if (is.finite(current_score) &&
        current_score > best_score) {
      
      best_score <- current_score
      best_membership <- membership
    }
  }
  
  if (is.null(best_membership)) {
    stop("The core-periphery optimization failed.")
  }
  
  # Label the group with membership 1 as the core.
  # The optimization has already defined this group.
  core_membership <- best_membership
  
  # Calculate a node-level core score.
  #
  # This is not the original B&E fit statistic. It is a useful
  # descriptive score: each node's weighted connection to the
  # estimated core, normalized by its maximum possible value.
  core_nodes <- which(core_membership == 1)
  
  core_score <- rowSums(W[, core_nodes, drop = FALSE])
  
  if (length(core_nodes) > 0) {
    core_score <- core_score / length(core_nodes)
  }
  
  list(
    membership = core_membership,
    core_score = core_score,
    fit = best_score,
    ideal_matrix = outer(
      core_membership,
      core_membership,
      FUN = "*"
    ),
    observed_matrix = W
  )
}


# ============================================================
# Function to compute all metrics for one dataset
# ============================================================

compute_network_metrics <- function(d,
                                    period_label,
                                    corr_threshold = 0.67,
                                    cp_restarts = 100,
                                    cp_seed = 123) {
  
  # Keep only sufficiently strong positive correlations
  d <- d %>%
    filter(
      !is.na(Correlation),
      Correlation > corr_threshold
    )
  
  if (nrow(d) == 0) {
    stop(
      paste(
        "No edges remain for period:",
        period_label
      )
    )
  }
  
  # Create a consistent undirected edge orientation
  d$from <- ifelse(
    d$Avg_site_id1 < d$Avg_site_id2,
    as.character(d$City1),
    as.character(d$City2)
  )
  
  d$to <- ifelse(
    d$Avg_site_id1 < d$Avg_site_id2,
    as.character(d$City2),
    as.character(d$City1)
  )
  
  # Make sure duplicate city pairs are handled consistently
  d <- d %>%
    group_by(from, to) %>%
    summarise(
      Correlation = mean(Correlation, na.rm = TRUE),
      .groups = "drop"
    )
  
  # Create the graph.
  #
  # Since correlations are symmetric, an undirected graph is the
  # most appropriate representation for the core-periphery model.
  g_und <- graph_from_data_frame(
    d[, c("from", "to", "Correlation")],
    directed = FALSE
  )
  
  E(g_und)$weight <- E(g_und)$Correlation
  
  # Add any cities that occur in the data but happen to have no
  # surviving edge after thresholding.
  all_cities <- sort(unique(c(
    as.character(d$from),
    as.character(d$to)
  )))
  
  missing_cities <- setdiff(all_cities, V(g_und)$name)
  
  if (length(missing_cities) > 0) {
    g_und <- add_vertices(
      g_und,
      nv = length(missing_cities),
      name = missing_cities
    )
  }
  
  # ------------------------------------------------------------
  # Directed metrics
  #
  # Your original data are correlations, so direction is artificial
  # here. We retain the directed metrics for compatibility with your
  # original code, but these should not be interpreted as causal
  # in-degree or out-degree.
  # ------------------------------------------------------------
  
  g <- as.directed(g_und, mode = "arbitrary")
  
  indeg <- degree(g, mode = "in")
  outdeg <- degree(g, mode = "out")
  
  instr <- strength(
    g,
    mode = "in",
    weights = E(g)$weight
  )
  
  outstr <- strength(
    g,
    mode = "out",
    weights = E(g)$weight
  )
  
  mean_in_corr <- ifelse(
    indeg > 0,
    instr / indeg,
    NA_real_
  )
  
  mean_out_corr <- ifelse(
    outdeg > 0,
    outstr / outdeg,
    NA_real_
  )
  
  tot_deg <- indeg + outdeg
  tot_str <- instr + outstr
  
  mean_corr_all <- ifelse(
    tot_deg > 0,
    tot_str / tot_deg,
    NA_real_
  )
  
  # Correlations are positive after thresholding, so 1/correlation
  # can be used as a distance for path-based measures.
  dist_w <- 1 / E(g)$weight
  
  closen_in <- closeness(
    g,
    mode = "in",
    weights = dist_w,
    normalized = TRUE
  )
  
  closen_out <- closeness(
    g,
    mode = "out",
    weights = dist_w,
    normalized = TRUE
  )
  
  betw <- betweenness(
    g,
    directed = TRUE,
    weights = dist_w,
    normalized = TRUE
  )
  
  eig_in <- eigen_centrality(
    g,
    directed = TRUE,
    scale = TRUE,
    weights = E(g)$weight
  )$vector
  
  auth <- authority.score(
    g,
    weights = E(g)$weight
  )$vector
  
  hub <- hub.score(
    g,
    weights = E(g)$weight
  )$vector
  
  # ------------------------------------------------------------
  # Ordinary unweighted coreness
  # ------------------------------------------------------------
  
  core_num <- coreness(
    g_und,
    mode = "all"
  )
  
  # ------------------------------------------------------------
  # Weighted Borgatti-Everett model
  # ------------------------------------------------------------
  
  adjacency_matrix <- as.matrix(
    as_adjacency_matrix(
      g_und,
      attr = "weight",
      sparse = FALSE
    )
  )
  
  # Ensure matrix order agrees with all output vectors
  node_names <- V(g_und)$name
  rownames(adjacency_matrix) <- node_names
  colnames(adjacency_matrix) <- node_names
  
  cp_fit <- fit_weighted_be_core(
    A = adjacency_matrix,
    n_restarts = cp_restarts,
    seed = cp_seed
  )
  
  cp_membership <- cp_fit$membership
  names(cp_membership) <- node_names
  
  cp_score <- cp_fit$core_score
  names(cp_score) <- node_names
  
  # The optimization labels the group with value 1 as the core.
  core_flag <- ifelse(
    cp_membership == 1,
    "core",
    "periphery"
  )
  
  names(core_flag) <- node_names
  
  # Return a data frame with all metrics
  result <- data.frame(
    period = period_label,
    City = node_names,
    indegree = as.numeric(indeg[node_names]),
    outdegree = as.numeric(outdeg[node_names]),
    instrength = as.numeric(instr[node_names]),
    outstrength = as.numeric(outstr[node_names]),
    mean_in_corr = as.numeric(mean_in_corr[node_names]),
    mean_out_corr = as.numeric(mean_out_corr[node_names]),
    mean_corr_all = as.numeric(mean_corr_all[node_names]),
    closeness_in = as.numeric(closen_in[node_names]),
    closeness_out = as.numeric(closen_out[node_names]),
    betweenness = as.numeric(betw[node_names]),
    eigen_in = as.numeric(eig_in[node_names]),
    hub = as.numeric(hub[node_names]),
    authority = as.numeric(auth[node_names]),
    coreness = as.numeric(core_num[node_names]),
    
    # Borgatti-Everett outputs
    be_membership = as.integer(cp_membership[node_names]),
    be_core_score = as.numeric(cp_score[node_names]),
    be_core_flag = as.character(core_flag[node_names]),
    
    # Network-level model fit, repeated for convenient export
    be_fit = cp_fit$fit,
    
    row.names = NULL
  )
  
  return(result)
}


