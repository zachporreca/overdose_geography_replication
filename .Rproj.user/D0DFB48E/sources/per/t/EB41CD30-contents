  "I-35", "I-40", "I-55", "I-65", "I-70",
  "I-75", "I-80", "I-90", "I-94", "I-95"
)

interstate_labels_major <- interstate_labels %>%
  filter(route_label %in% major_routes)


#===========================
# Map of full network
#===========================

library(scales)

# Automatically determine the boundary between periphery and core
core_threshold <- min(
  res_all$coreness[res_all$core_flag == "core"],
  na.rm = TRUE
)

# Determine observed score limits
score_min <- min(res_all$coreness, na.rm = TRUE)
score_max <- max(res_all$coreness, na.rm = TRUE)

# Create a color position:
# 0 = lowest periphery score
# 0.5 = core/periphery boundary
# 1 = highest core score
res_all <- res_all %>%
  mutate(
    color_position = case_when(
      coreness < core_threshold ~ rescale(
        coreness,
        to = c(0, 0.5),
        from = c(score_min, core_threshold)
      ),
      
      coreness >= core_threshold ~ rescale(
        coreness,
        to = c(0.5, 1),
        from = c(core_threshold, score_max)
      ),
      
      TRUE ~ NA_real_
    )
  )

ggplot() +
  geom_polygon(
    data = world_sub,
    aes(x = long, y = lat, group = group),
    fill = "grey95",
    color = "grey70",
    linewidth = 0.3
  ) +
  
  geom_polygon(
    data = us_map,
    aes(x = long, y = lat, group = group),
    fill = NA,
    color = "grey",
    linewidth = 0.4
  ) +
  
  geom_sf(
    data = interstates_crop,
    inherit.aes = FALSE,
    color = "grey55",
    linewidth = 0.25,
    alpha = 0.55
  ) +
  
  geom_sf_label(
    data = interstate_labels_major,
    aes(label = route_label),
    inherit.aes = FALSE,
    size = 3.2,
    color = "white",
    fill = "#1F4E79",
    fontface = "bold",
    alpha = 0.98,
    linewidth = 0.4,
    label.padding = grid::unit(0.14, "lines"),
    label.r = grid::unit(0.08, "lines"),
    show.legend = FALSE
  ) +
  
  geom_point(
    data = res_all,
    aes(
      x = longitude,
      y = latitude,
      color = color_position
    ),
    size = 2,
    alpha = 0.9
  ) +
  
  scale_color_gradientn(
    name = "Coreness score",
    colours = c(
      "#67001F",  # lowest periphery: dark burgundy
      "#B2182B",  # low periphery: red
      "#EF8A62",  # higher periphery: coral
      "#D8C39A",  # core/periphery boundary: tan
      "#67A9CF",  # lower core: light blue
      "#2166AC",  # higher core: blue
      "#053061"   # highest core: dark navy
    ),
    values = c(0, 0.20, 0.40, 0.50, 0.60, 0.80, 1),
    limits = c(0, 1),
    breaks = c(
      0,
      0.25,
      0.5,
      0.75,
      1
    ),
    labels = c(
      score_min,
      round(score_min + (core_threshold - score_min) * 0.5, 1),
      paste0("Boundary: ", core_threshold),
      round(core_threshold + (score_max - core_threshold) * 0.5, 1),
      score_max
    ),
    guide = guide_colorbar(
      barheight = grid::unit(6, "cm"),
      frame.colour = "grey40",
      ticks.colour = "grey30"
    )
  ) +
  
  coord_sf(
    xlim = c(lon_min, lon_max),
    ylim = c(lat_min, lat_max),
    crs = sf::st_crs(4326),
    default_crs = sf::st_crs(4326),
    expand = FALSE
  ) +
  
  labs(
    title = "Core–Periphery Full Sample",
    x = NULL,
    y = NULL
  ) +
  
  base_theme +
  theme(
    legend.position = "right",
    legend.title = element_text(size = 9),
    legend.text = element_text(size = 8)
  )

